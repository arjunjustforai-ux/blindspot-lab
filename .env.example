# ---------------------------------------------------------------------------
# Blindspot Lab configuration. Copy to .env and adjust. Never commit real keys.
# ---------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL 16 with the pgvector extension
DATABASE_URL=postgresql+psycopg://blindspot:blindspot@localhost:5432/blindspot

# Auth: change in every non-local deployment (long random string)
JWT_SECRET=change-me-to-a-long-random-string
# Optional: accept Supabase Auth access tokens (Project Settings -> API -> JWT secret)
SUPABASE_JWT_SECRET=

# Storage: "local" (filesystem / mounted volume) or "supabase"
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=course-materials

# Upload limits
MAX_DOCUMENT_MB=60
MAX_VIDEO_MB=400
MAX_VIDEO_MINUTES=90

# ---- AI providers ----------------------------------------------------------
# LLM_PROVIDER=local  -> no external model calls: extractive grounded answers,
#                        rule-based diagnosis, template/bank/extractive questions.
# LLM_PROVIDER=openai -> any OpenAI-compatible endpoint (OpenAI, Groq, Together,
#                        vLLM, Ollama, llama.cpp server ...). Course content is
#                        sent to that provider; disclose this to users.
LLM_PROVIDER=local
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Use a different model here for cross-model question verification
VERIFIER_MODEL=
VISION_MODEL=

# Embeddings: local ONNX (BAAI/bge-small-en-v1.5, 384-d) or OpenAI-compatible
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=384

# Speech-to-text: local faster-whisper or OpenAI-compatible /audio/transcriptions
TRANSCRIPTION_PROVIDER=local
WHISPER_MODEL=base.en

# Where local models are cached (downloaded on first use from Hugging Face)
MODEL_CACHE_DIR=./data/models

# Cost/safety bounds
MAX_VISION_CALLS_PER_SOURCE=24
MAX_LLM_CALLS_PER_USER_PER_DAY=400

# Runtime
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RUN_WORKER_IN_PROCESS=true
DEMO_ENABLED=true

# Frontend (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:8000
